{
  "name": "cut-editor",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "predev": "node scripts/generate-font-manifest.mjs && node scripts/copy-mediapipe-wasm.mjs",
    "prebuild": "node scripts/generate-font-manifest.mjs && node scripts/copy-mediapipe-wasm.mjs",
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "lint": "eslint . --cache --cache-location node_modules/.cache/eslint",
    "lint:fix": "eslint . --fix --cache --cache-location node_modules/.cache/eslint",
    "pretest": "node -e \"if (Number(process.versions.node.split('.')[0]) < 24) { console.error('Node 24 이상이 필요합니다'); process.exit(1); }\"",
    "test": "node --test \"tests/**/*.test.mjs\" \"tests/**/*.test.ts\""
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "0.10.35",
    "@vercel/analytics": "1.5.0",
    "@vercel/speed-insights": "^1.2.0",
    "konva": "^9.3.22",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-konva": "^18.2.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.34.0",
    "@types/node": "24.19.2",
    "@types/react": "^18.2.66",
    "@types/react-dom": "^18.2.22",
    "@typescript-eslint/eslint-plugin": "^8.42.0",
    "@typescript-eslint/parser": "^8.42.0",
    "@vitejs/plugin-react": "^4.2.1",
    "eslint": "^9.34.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.4.6",
    "globals": "^16.3.0",
    "typescript": "^5.2.2",
    "typescript-eslint": "^8.42.0",
    "vite": "^5.2.0"
  }
}
